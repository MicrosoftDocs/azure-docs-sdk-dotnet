    <Member MemberName="ResilientBackground">
      <MemberSignature Language="C#" Value="public bool ResilientBackground { get; set; }" />
      <MemberSignature Language="ILAsm" Value=".property instance bool ResilientBackground" />
      <MemberSignature Language="DocId" Value="P:Azure.AI.AgentServer.Responses.ResponsesServerOptions.ResilientBackground" />
      <MemberSignature Language="VB.NET" Value="Public Property ResilientBackground As Boolean" />
      <MemberSignature Language="F#" Value="member this.ResilientBackground : bool with get, set" Usage="Azure.AI.AgentServer.Responses.ResponsesServerOptions.ResilientBackground" />
      <MemberType>Property</MemberType>
