      <MemberSignature Language="C#" Value="public string MaxConcurrency { get; set; }" />
      <MemberSignature Language="ILAsm" Value=".property instance string MaxConcurrency" />
      <MemberSignature Language="DocId" Value="P:Azure.ResourceManager.ContainerServiceFleet.Models.ContainerServiceFleetUpdateStage.MaxConcurrency" />
