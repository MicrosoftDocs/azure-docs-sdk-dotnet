  <Docs>
    <summary>
            This is the base type that represents an advanced filter. To configure an advanced filter, do not directly instantiate an object of this class. Instead, instantiate an object of a derived class such as BoolEqualsAdvancedFilter, NumberInAdvancedFilter, StringEqualsAdvancedFilter etc. depending on the type of the key based on which you want to filter.
            Please note this is the base class. The derived classes available for instantiation are: <see cref="T:Azure.Provisioning.EventGrid.NumberInAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.NumberNotInAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.NumberLessThanAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.NumberGreaterThanAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.NumberLessThanOrEqualsAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.NumberGreaterThanOrEqualsAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.BoolEqualsAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringInAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringNotInAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringBeginsWithAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringEndsWithAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringContainsAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.NumberInRangeAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.NumberNotInRangeAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringNotBeginsWithAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringNotEndsWithAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.StringNotContainsAdvancedFilter" />, <see cref="T:Azure.Provisioning.EventGrid.IsNullOrUndefinedAdvancedFilter" />, and <see cref="T:Azure.Provisioning.EventGrid.IsNotNullAdvancedFilter" />.
            </summary>
