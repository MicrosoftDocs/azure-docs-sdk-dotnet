      <MemberSignature Language="C#" Value="public static Guid? SessionInstanceId { get; }" />
      <MemberSignature Language="ILAsm" Value=".property valuetype System.Nullable`1&lt;valuetype System.Guid&gt; SessionInstanceId" />
